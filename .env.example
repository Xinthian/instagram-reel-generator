# Generate .env with: python3 scripts/setup-env.py
# No app login; keep remote access private.
# Optional for manual captions; required for AI headlines and screenshot captions.
OPENROUTER_API_KEY=
# Set false to disable AI even when a provider key is configured.
AI_CAPTIONS_ENABLED=true
# Free models only; paid model IDs are rejected by the app.
OPENROUTER_MODEL=openrouter/free
# Bind only to localhost by default. Use a TLS proxy for remote access.
BIND_ADDRESS=127.0.0.1
# Optional cookies override only; path must be an existing readable regular file.
# COOKIES_PATH=/absolute/path/to/cookies.txt
# Filled by setup-env.py; used only by the optional cookie mount override.
REEL_UID=
REEL_GID=
MAX_VIDEO_BYTES=104857600
MAX_SCREENSHOT_BYTES=10485760
MAX_VIDEO_SECONDS=180
MAX_CONCURRENT_JOBS=1
