{
  "name": "Reel Generator",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "containerEnv": {
    "AI_CAPTIONS_ENABLED": "true",
    "OPENROUTER_MODEL": "openrouter/free"
  },
  "forwardPorts": [
    7008
  ],
  "portsAttributes": {
    "7008": {
      "label": "Reel Generator",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "bash .devcontainer/start.sh",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "remoteUser": "vscode"
}
